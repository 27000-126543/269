NODE_ENV=development

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=hr@company.com
SMTP_PASS=your-password
SMTP_FROM=HR System <hr@company.com>

SMS_API_KEY=your-sms-api-key
SMS_API_URL=https://sms-api.example.com/send

BANK_NAME=ICBC
BANK_BATCH_SIZE=1000

LOG_LEVEL=info
LOG_FILE=./logs/payroll.log

MAX_CONCURRENT_EMPLOYEES=500
ENABLE_CACHE=true
