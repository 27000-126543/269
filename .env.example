# ========================================
# 薪酬管理系统环境变量配置示例
# ========================================
# 复制此文件为 .env 并填入实际配置值

# ----------------------------------------
# 系统环境配置
# ----------------------------------------
NODE_ENV=development
# 可选值: development, production, test

# ----------------------------------------
# SMTP邮件服务配置 (用于发送工资条和审批通知)
# ----------------------------------------
# SMTP服务器地址
SMTP_HOST=smtp.example.com
# 示例: smtp.qq.com, smtp.163.com, smtp.gmail.com, smtp.office365.com

# SMTP端口
SMTP_PORT=587
# 常用端口: 25 (非加密), 465 (SSL加密), 587 (TLS加密)

# SMTP用户名
SMTP_USER=hr@company.com
# 通常是你的邮箱地址

# SMTP密码或授权码
SMTP_PASS=your-password
# 注意: QQ邮箱、163邮箱等需要使用授权码而非登录密码

# 发件人显示名称和邮箱
SMTP_FROM=HR System <hr@company.com>

# SMTP是否使用安全连接 (true/false)
SMTP_SECURE=false
# 端口465时设为true，端口587时设为false

# ----------------------------------------
# 短信服务配置 (可选)
# ----------------------------------------
SMS_API_KEY=your-sms-api-key
SMS_API_URL=https://sms-api.example.com/send

# ----------------------------------------
# 银行代发文件配置
# ----------------------------------------
BANK_NAME=ICBC
BANK_BATCH_SIZE=1000

# ----------------------------------------
# 日志配置
# ----------------------------------------
LOG_LEVEL=info
# 可选值: error, warn, info, debug
LOG_FILE=./logs/payroll.log

# ----------------------------------------
# 性能配置
# ----------------------------------------
MAX_CONCURRENT_EMPLOYEES=500
ENABLE_CACHE=true

# ----------------------------------------
# JWT配置
# ----------------------------------------
JWT_SECRET=your-jwt-secret-key-here
# 请修改为随机字符串，用于生成登录token
JWT_EXPIRES_IN=24h
# token过期时间，如: 24h, 7d, 30d

# ----------------------------------------
# 服务器配置
# ----------------------------------------
PORT=8080
# 后端服务端口

# ========================================
# SMTP配置说明
# ========================================
# 
# 【QQ邮箱配置示例】:
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=your-qq@qq.com
# SMTP_PASS=your-authorization-code
# SMTP_FROM=HR System <your-qq@qq.com>
# SMTP_SECURE=true
# 
# 【163邮箱配置示例】:
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_USER=your-163@163.com
# SMTP_PASS=your-authorization-code
# SMTP_FROM=HR System <your-163@163.com>
# SMTP_SECURE=true
# 
# 【Gmail配置示例】:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=HR System <your@gmail.com>
# SMTP_SECURE=false
# 
# 【企业邮箱/Outlook配置示例】:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=your@company.com
# SMTP_PASS=your-password
# SMTP_FROM=HR System <your@company.com>
# SMTP_SECURE=false
# 
# 注意事项:
# 1. 大多数邮箱服务商需要在设置中开启SMTP服务
# 2. QQ邮箱、163邮箱等需要使用"授权码"而非登录密码
# 3. 如遇连接问题，请检查防火墙和网络设置
# ========================================
